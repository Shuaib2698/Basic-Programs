''' Largest of Three Numbers Without using max().

Example:

5 12 9

Output:
12 '''
a = int(input("Enter the number : "))
b = int(input("Enter the number : "))
c = int(input("Enter the number : "))

if a >= b and a >= c:
    print("a is the largest number with ", a)
elif b >= a and b >= c:
    print("b is the largest number with ", b)
else:
    print("c is the largest number with ", c)